# 默认按文本处理，统一换行符为 LF
* text=auto eol=lf

# Windows 批处理脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不参与 diff / 换行转换
*.pt   binary
*.pth  binary
*.npy  binary
*.mp4  binary
*.avi  binary
*.mov  binary
*.gif  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.xlsx binary

# 语言统计
*.py   linguist-language=Python
*.md   linguist-documentation
